<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker artwork for the 2×2 widget, on hosts older than API 31 — from 31 the
  picker inflates previewLayout instead and this is never seen.

  The band's darkening is folded into the background's own gradient rather than
  drawn as a second rect over it, so there is nothing to clip against the rounded
  corners: a dark rect pinned to the bottom would square off the two corners the
  path underneath had rounded.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="110dp"
    android:height="110dp"
    android:viewportWidth="110"
    android:viewportHeight="110">

    <path android:pathData="M12,0 L98,0 A12,12 0 0 1 110,12 L110,98 A12,12 0 0 1 98,110 L12,110 A12,12 0 0 1 0,98 L0,12 A12,12 0 0 1 12,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="110"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FF2E3446" android:offset="0" />
                <item android:color="#FF1B2130" android:offset="0.45" />
