<!--
  Status-bar / notification variant of the YZ Music custom logo mark.

  Notification small icons are drawn as a silhouette: the system throws away
  every colour and keeps only the alpha channel, so the fill/stroke has to be
  opaque white. The group scales the waveform mark to the 19x19 content
  box Android expects inside a 24x24 canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <group
      android:scaleX="0.11585"
      android:scaleY="0.11585"
      android:translateX="-13.024"
      android:translateY="-13.024">
    <!-- Waveform Bars -->
    <path
        android:pathData="M 148,201 L 148,231"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="18"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 182,177 L 182,255"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="18"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 216,143 L 216,289"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="18"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 250,177 L 250,255"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="18"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 284,201 L 284,231"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="18"
        android:strokeLineCap="round" />
  </group>
</vector>
