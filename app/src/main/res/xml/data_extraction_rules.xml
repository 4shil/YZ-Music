<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 and newer.

   See backup_rules.xml for why these files are excluded. The one thing that
   differs from Android 11 and older is that this file has two independent
   blocks: <cloud-backup> and <device-transfer>. A file excluded from only one
   of them still travels by the other route, which for a cleartext session
   cookie is the whole point of the exercise.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bitchord_auth.xml" />
        <exclude domain="sharedpref" path="bitchord_auth_plain.xml" />
        <exclude domain="sharedpref" path="yzmusic_sources.xml" />
        <exclude domain="sharedpref" path="yzmusic_sources_plain.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bitchord_auth.xml" />
        <exclude domain="sharedpref" path="bitchord_auth_plain.xml" />
        <exclude domain="sharedpref" path="yzmusic_sources.xml" />
        <exclude domain="sharedpref" path="yzmusic_sources_plain.xml" />
    </device-transfer>
</data-extraction-rules>
